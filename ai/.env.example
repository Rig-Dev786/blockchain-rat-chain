# RentProof AI Service — Environment Variables
# Copy to .env and fill in values before running

# --- Signing Keys ---
AI_PRIVATE_KEY_PATH=keys/private_key.pem
AI_PUBLIC_KEY_PATH=keys/public_key.pem

# --- Verdict Thresholds ---
# Delta score below this = FULL_REFUND (no meaningful new damage)
DAMAGE_THRESHOLD_NONE=3.0
# Delta score below this = PARTIAL_DEDUCTION
DAMAGE_THRESHOLD_MINOR=20.0

# --- Deduction Amounts (basis points, 10000 = 100%) ---
DEDUCTION_PARTIAL_BPS=3000   # 30% deduction
DEDUCTION_HOLD_BPS=10000     # 100% hold

# --- API ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
