{
  "name": "rentproof-blockchain",
  "version": "1.0.0",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "media:record": "hardhat run scripts/recordMedia.js --network sepolia",
    "media:hash-url": "node scripts/hashUrl.js",
    "media:verify": "node scripts/verifyMedia.js",
    "agreement:create": "hardhat run scripts/createAgreementWithMedia.js --network sepolia",
    "agreement:before": "hardhat run scripts/submitBeforeMedia.js --network sepolia",
    "agreement:after": "hardhat run scripts/submitAfterMedia.js --network sepolia",
    "agreement:ai": "hardhat run scripts/recordAIVerdict.js --network sepolia",
    "agreement:release": "hardhat run scripts/releaseFromVerdict.js --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.22.0",
    "dotenv": "^16.0.0"
  }
}
